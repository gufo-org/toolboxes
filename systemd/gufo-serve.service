[Unit]
Description=Gufo Inference Server (AMD Strix Halo gfx1151 + XDNA2)
After=network.target local-fs.target
Documentation=https://github.com/gufo-org/toolboxes

[Service]
Type=simple
Environment=PORT=8080

# Run inside the gufo-runtime container using podman
ExecStart=/usr/bin/podman run --rm --name gufo-serve \
  --userns=keep-id:uid=1000,gid=1000 \
  --device /dev/kfd --device /dev/dri \
  --group-add keep-groups --ulimit memlock=-1 \
  -v %h/.local/share/gufo/models:/models:ro,z \
  -p 127.0.0.1:${PORT}:${PORT} \
  ghcr.io/gufo-org/toolboxes/gufo-runtime:latest \
  gufo serve llm --model /models/model.gguf --host 0.0.0.0 --port ${PORT}

ExecStop=/usr/bin/podman stop -t 10 gufo-serve
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
