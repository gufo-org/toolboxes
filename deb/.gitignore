# build residue: dh staging and generated state never belong in the lane
debhelper/
.debhelper/
*.deb
*.buildinfo
*.changes
# a build assembles <checkout>/debian/ from common/; a stray staging dir here is output
/common/gufo/
/common/gufo-rocm-repo/
/common/files

# generated at build time from version.txt + the engine CHANGELOG.md; never tracked,
# because a tracked changelog is stale by definition the moment a release is cut
/common/changelog
